{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project256.com/schemas/doctriage_bundle.v2.schema.json",
  "title": "DocTriage Bundle",
  "type": "object",
  "required": ["schema_version", "title", "generated_at", "source", "selection_policy", "statistics", "documents", "relations"],
  "properties": {
    "schema_version": {
      "const": "doctriage_bundle.v2"
    },
    "title": {"type": "string"},
    "generated_at": {"type": "string"},
    "source": {
      "type": "object",
      "properties": {
        "source_dir": {"type": "string"},
        "output_root": {"type": "string"},
        "decisions_path": {"type": "string"},
        "relations_path": {"type": "string"}
      },
      "additionalProperties": false
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "pipeline_status": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "is_partial": {"type": "boolean"},
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "exists": {"type": "boolean"},
          "size_bytes": {"type": "integer"}
        },
        "required": ["path", "exists", "size_bytes"],
        "additionalProperties": false
      }
    },
    "statistics": {
      "type": "object",
      "properties": {
        "document_count": {"type": "integer"},
        "relation_count": {"type": "integer"},
        "category_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "document_kind_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/document"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "document": {
      "type": "object",
      "required": ["id", "title", "paths", "classification", "scores", "text"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "paths": {
          "type": "object",
          "required": ["source", "target", "preferred", "relative"],
          "properties": {
            "source": {"type": "string"},
            "target": {"type": "string"},
            "preferred": {"type": "string"},
            "relative": {"type": "string"}
          },
          "additionalProperties": false
        },
        "classification": {
          "type": "object",
          "required": ["category", "document_kind", "topic_tags", "status", "media_type"],
          "properties": {
            "category": {"type": "string"},
            "document_kind": {"type": "string"},
            "topic_tags": {
              "type": "array",
              "items": {"type": "string"}
            },
            "status": {"type": "string"},
            "media_type": {"type": "string"}
          },
          "additionalProperties": false
        },
        "scores": {
          "type": "object",
          "required": [
            "quality",
            "knowledge_density",
            "implementation_specificity",
            "logical_structure",
            "evidence_richness",
            "actionability",
            "strategic_value",
            "freshness",
            "uniqueness",
            "sensitivity_risk",
            "public_writing_suitability"
          ],
          "properties": {
            "quality": {"$ref": "#/$defs/score"},
            "knowledge_density": {"$ref": "#/$defs/score"},
            "implementation_specificity": {"$ref": "#/$defs/score"},
            "logical_structure": {"$ref": "#/$defs/score"},
            "evidence_richness": {"$ref": "#/$defs/score"},
            "actionability": {"$ref": "#/$defs/score"},
            "strategic_value": {"$ref": "#/$defs/score"},
            "freshness": {"$ref": "#/$defs/score"},
            "uniqueness": {"$ref": "#/$defs/score"},
            "sensitivity_risk": {"$ref": "#/$defs/score"},
            "public_writing_suitability": {"$ref": "#/$defs/score"}
          },
          "additionalProperties": false
        },
        "text": {
          "type": "object",
          "required": ["summary", "reason"],
          "properties": {
            "summary": {"type": "string"},
            "reason": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["left_document_id", "right_document_id", "score", "signals", "evidence"],
      "properties": {
        "left_document_id": {"type": "string"},
        "right_document_id": {"type": "string"},
        "score": {"type": "number"},
        "signals": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence": {
          "type": "object",
          "required": [
            "filename_similarity",
            "time_proximity",
            "path_proximity",
            "embedding_similarity",
            "citation_count"
          ],
          "properties": {
            "filename_similarity": {"type": "number"},
            "time_proximity": {"type": "number"},
            "path_proximity": {"type": "number"},
            "embedding_similarity": {"type": "number"},
            "citation_count": {"type": "integer"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
