{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project256.com/schemas/doctriage_bundle.v1.schema.json",
  "title": "DocTriage Bundle",
  "type": "object",
  "required": ["schema_version", "title", "generated_at", "source", "selection_policy", "statistics", "documents", "relations"],
  "properties": {
    "schema_version": {
      "const": "doctriage_bundle.v1"
    },
    "title": {"type": "string"},
    "generated_at": {"type": "string"},
    "source": {
      "type": "object",
      "properties": {
        "source_dir": {"type": "string"},
        "output_root": {"type": "string"},
        "decisions_path": {"type": "string"},
        "relations_path": {"type": "string"}
      },
      "additionalProperties": true
    },
    "selection_policy": {"type": "object"},
    "statistics": {
      "type": "object",
      "properties": {
        "document_count": {"type": "integer"},
        "relation_count": {"type": "integer"},
        "category_counts": {"type": "object"},
        "document_kind_counts": {"type": "object"}
      },
      "additionalProperties": true
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "document": {
      "type": "object",
      "required": ["id", "source_path", "relative_path", "quality", "category"],
      "properties": {
        "id": {"type": "string"},
        "source_path": {"type": "string"},
        "target_path": {"type": "string"},
        "preferred_path": {"type": "string"},
        "relative_path": {"type": "string"},
        "title": {"type": "string"},
        "category": {"type": "string"},
        "document_kind": {"type": "string"},
        "topic_tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "quality": {"$ref": "#/$defs/score"},
        "sensitivity_risk": {"$ref": "#/$defs/score"},
        "public_writing_suitability": {"$ref": "#/$defs/score"},
        "summary": {"type": "string"},
        "reason": {"type": "string"},
        "status": {"type": "string"},
        "media_type": {"type": "string"}
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["left_relative_path", "right_relative_path", "relation_score"],
      "properties": {
        "left_relative_path": {"type": "string"},
        "right_relative_path": {"type": "string"},
        "relation_score": {"type": "number"},
        "signals": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    }
  }
}
