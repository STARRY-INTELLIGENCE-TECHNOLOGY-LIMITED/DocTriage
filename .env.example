# DocTriage environment template.
# Copy this file to `.env` and adjust paths/model names for your machine.
# Keep `.env` private: it may contain local paths, model endpoints, and API keys.


# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------

# Main JSON-generation endpoint.
# Ollama generate endpoint: http://localhost:11434/api/generate
# Ollama chat endpoint:     http://localhost:11434/api/chat
# OpenAI/OpenAI-compatible chat endpoint: https://api.openai.com/v1/chat/completions
# Cloud endpoints should be paired with LLM_API_KEY.
LLM_ENDPOINT=http://localhost:11434/api/generate

# Main scoring/classification model.
# Examples: gemma4:e4b for Ollama, or a chat/completions model for cloud providers.
LLM_MODEL=gemma4:e4b

# Optional bearer token for remote/OpenAI-compatible endpoints.
# Leave blank for local Ollama.
LLM_API_KEY=

# LLM request timeout and retry count.
# Increase timeout for slower local models or OCR-heavy documents.
LLM_TIMEOUT_SECONDS=240
LLM_RETRY_COUNT=1

# Ollama context window option. Larger values consume more memory.
LLM_NUM_CTX=8192


# ---------------------------------------------------------------------------
# Input/output safety
# ---------------------------------------------------------------------------

# Source folder to scan. The pipeline never deletes or moves files in this folder.
SOURCE_DIR=./pending_docs

# Output folder for state logs, progress, decisions, relationships, and optional copies.
# Do not place this inside SOURCE_DIR; the pipeline rejects that layout.
OUTPUT_ROOT=./processed_knowledge

# When false, DocTriage only writes decisions/state logs and does not copy source documents.
# Recommended first-pass setting for private or large collections.
COPY_FILES=false

# Maximum number of files for a run. Uncomment for smoke tests.
# MAX_FILES=20

# Skip files larger than this size in MB. Uncomment for first-pass runs.
# MAX_FILE_SIZE_MB=100


# ---------------------------------------------------------------------------
# Runtime throughput
# ---------------------------------------------------------------------------

# Concurrent LLM requests. Keep at 1 for a single local Ollama model unless you have spare GPU/CPU.
CONCURRENCY_LIMIT=1

# Quality score threshold for routing documents into HQ categories.
# Lower-scored documents go to LQ_Archive when COPY_FILES=true.
QUALITY_THRESHOLD=75

# Directory-level manifest analysis sends file inventories to the LLM for series detection.
# Default true starts file-level scoring immediately and avoids a long pre-run manifest stage.
# Set false when directory-level series detection is more important than throughput.
SKIP_MANIFEST_ANALYSIS=true

# Maximum files sent in one directory manifest prompt.
MANIFEST_MAX_FILES=80


# ---------------------------------------------------------------------------
# Parsing and local summaries
# ---------------------------------------------------------------------------

# Enable OCR for PDFs via docling. This can be slow on large folders.
# For fast first-pass runs, keep false and rely on PDF text fallback.
OCR_ENABLED=false

# If docling fails on a PDF, use local pypdf text extraction as fallback.
PDF_TEXT_FALLBACK_ENABLED=true

# Extract native PDF metadata in the profiler.
# Disabled by default because cleaner.py may already read PDF text, and reopening every PDF
# can be expensive on large runs.
PDF_METADSample_ENABLED=false

# Maximum pages extracted by PDF text fallback.
# Lower values improve throughput; higher values may improve classification.
PDF_TEXT_FALLBACK_MAX_PAGES=300

# Store a short local summary in decisions.jsonl for relationship mining.
# Disable if you do not want any content snippet persisted in output logs.
DOCUMENT_SUMMARY_ENABLED=false
DOCUMENT_SUMMARY_MAX_CHARS=600

# Language for generated summaries and reasons.
# Use auto to infer from the document body.
OUTPUT_LANGUAGE=auto


# ---------------------------------------------------------------------------
# Resume, rerun, and change detection
# ---------------------------------------------------------------------------

# Compare source fingerprint and settings signature before skipping previous work.
# Default fingerprint uses size_bytes + mtime_ns + ctime_ns.
CHANGE_DETECTION_ENABLED=true

# Include SHA-256 content hash in fingerprints.
# Stronger but much slower for large document collections.
CHANGE_DETECTION_USE_CONTENT_HASH=false

# Ignore processed state and reprocess selected files.
FORCE_REPROCESS=false

# Retry files that previously failed.
# Set false to skip previous failures when source/settings fingerprint is unchanged.
RETRY_FAILED=true

# When COPY_FILES=true and a changed source/settings rerun resolves to an existing target,
# refresh that target copy. This never overwrites source documents.
OVERWRITE_CHANGED_TARGET=true

# Bump this when pipeline semantics change and you want old decisions to be recomputed.
PIPELINE_VERSION=0.1.0


# ---------------------------------------------------------------------------
# Runtime progress
# ---------------------------------------------------------------------------

# Periodically log progress and write OUTPUT_ROOT/_state/progress.json.
PROGRESS_ENABLED=true

# Progress log/write interval in seconds.
PROGRESS_LOG_INTERVAL_SECONDS=30


# ---------------------------------------------------------------------------
# Relationship mining
# ---------------------------------------------------------------------------

# Run relationship mining after the main scoring pipeline completes.
# You can also run relationship_miner.py separately.
RELATIONSHIP_MINING_ENABLED=false

# Optional embedding signal for relationship mining.
# Disabled by default because it consumes local model resources and is slower.
RELATIONSHIP_USE_EMBEDDINGS=false

# Optional lightweight citation signal.
# Uses titles/paths and available text/summary to detect explicit cross-document mentions.
RELATIONSHIP_USE_TEXT_CITATIONS=false

# Minimum score for retaining a candidate relationship.
RELATIONSHIP_MIN_SCORE=0.72

# Candidate generation windows.
# Larger values find more relationships but increase pair scoring cost.
RELATIONSHIP_MAX_CANDIDATES_PER_FILE=12
RELATIONSHIP_FILENAME_WINDOW=8
RELATIONSHIP_TIME_WINDOW=8

# Time proximity decay. Smaller means timestamps must be closer to contribute strongly.
RELATIONSHIP_TIME_DECAY_DAYS=30

# Embedding-neighbor settings used only when RELATIONSHIP_USE_EMBEDDINGS=true.
RELATIONSHIP_EMBEDDING_TOP_K=5

# Embedding pair scoring is exhaustive only under this record count.
# Above this, embedding vectors are cached but not used for all-pairs expansion.
RELATIONSHIP_EMBEDDING_EXHAUSTIVE_LIMIT=1000

# When embedding relationships run immediately after scoring through Ollama,
# DocTriage asks Ollama to unload LLM_MODEL and waits only for that model to
# disappear from /api/ps. It does not wait for total GPU memory to become zero.
RELATIONSHIP_EMBEDDING_LLM_UNLOAD_TIMEOUT_SECONDS=60
RELATIONSHIP_EMBEDDING_LLM_UNLOAD_POLL_SECONDS=1


# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------

# Ollama embedding endpoint.
# Newer Ollama also supports /api/embed; this client supports both payload shapes.
# OpenAI/OpenAI-compatible embedding endpoint: https://api.openai.com/v1/embeddings
EMBEDDING_ENDPOINT=http://localhost:11434/api/embeddings

# Embedding model. Uncomment after pulling/installing a local embedding model,
# or set a cloud embedding model when using an OpenAI-compatible endpoint.
# Example: ollama pull nomic-embed-text
# EMBEDDING_MODEL=nomic-embed-text

# Optional bearer token for the embedding endpoint.
# Leave blank to reuse LLM_API_KEY when a remote embedding endpoint needs auth.
EMBEDDING_API_KEY=

# Embedding request timeout.
EMBEDDING_TIMEOUT_SECONDS=120

# Maximum characters sent to the embedding model per document.
EMBEDDING_TEXT_MAX_CHARS=1200

# Cache embeddings under OUTPUT_ROOT/_state/embedding_cache.jsonl.
EMBEDDING_CACHE_ENABLED=true
